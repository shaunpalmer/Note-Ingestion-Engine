          "ADR-003-llm-is-reasoner-not-tag-stamper.md",
          "ADR-004-magic-bytes-before-extension.md",
          "ADR-005-review-first-before-auto-archive.md"
        ],
        "design": [
          "AI_ARCHITECTURE_GUARDRAILS.json",
