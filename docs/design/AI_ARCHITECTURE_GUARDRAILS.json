  "core_contracts": {
    "ExtractionResult": {
      "purpose": "Stage 1 output contract. Extraction must report what happened, not merely return text.",
      "fields": {
        "text": "string",
        "source_meta": {
          "source_path": "string",
          "source_hash": "sha256",
          "detected_mime": "string",
          "original_extension": "string",
          "adapter_used": "string",
          "created_at": "datetime|null",
          "modified_at": "datetime|null"
        },
        "status": [
          "ok",
          "empty",
          "ocr_needed",
          "corrupt",
          "unsupported",
          "metadata_only"
        ],
        "warnings": "list[string]"
      }
    },
    "DecisionNote": {
      "purpose": "Stage 3 output contract. The LLM must recover usable knowledge, not merely tag the file.",
      "fields": {
        "title": "string",
        "note_type": "string",
        "essence": "string",
        "summary": "string",
        "why_it_matters": "list[string]",
        "key_points": "list[string]",
        "keep_facts": "list[string]",
        "business_area": "list[string]",
        "project": "list[string]",
        "people": "list[string]",
        "organisations": "list[string]",
        "topics": "list[string]",
        "proposed_links": "list[string]",
        "tags": "list[string]",
        "possible_actions": "list[string]",
        "answers_future_questions": "list[string]",
        "source_relevance": "string",
        "value_score": "float_0_to_1",
        "scrap_score": "float_0_to_1",
        "uncertainty": "float_0_to_1",
        "uncertainty_reason": "string",
        "fact_interpretation_boundary": "string",
        "discarded_summary": "string",
        "raw_excerpt": "string"
      }
    }
  },

