  "copilot_review_instructions": {
    "mode": "review_before_code",
    "instructions": [
      "Evaluate current project against this guardrail file.",
      "Do not write implementation code unless explicitly asked.",
      "Do not optimise the old legacy flow.",
      "Identify whether each existing file should be kept, wrapped, retired, or rewritten.",
      "Check whether any proposed change improves retrieval, trust, provenance, transformation quality, or decision support.",
      "Flag any work that only improves filing without improving knowledge recovery.",
      "Treat Stage 3 output quality as the highest-risk/highest-value part of the system."
    ]
  },

  "success_metrics": {
    "bad_metric": "Number of files processed.",
    "acceptable_metric": "Number of files safely extracted with known status.",
    "better_metric": "Percentage of generated notes that are more useful than the raw source.",
    "best_metric": "How often Shaun can find forgotten material and make a better decision from it.",
    "manual_review_test": "Review 20 generated notes and ask: would this help me find, understand, trust, connect, or act on this material later?"
  }
}