{
  "project": {
    "name": "Local Knowledge Ingestion Pipeline",
    "purpose": "Recover value from old, mixed-format files and turn them into trusted, searchable, linked, decision-ready Obsidian knowledge.",
    "not_the_purpose": [
      "Not merely sorting files",
      "Not merely tagging documents",
      "Not merely creating summaries",
      "Not merely building a personal wiki",
      "Not building a clever pipeline that produces low-value notes faster"
    ],
    "north_star": "The output note must help Shaun find, understand, trust, connect, or act on old material later."
  },

  "architecture_guardrails": {
    "primary_rule": "Transformation comes before filing.",
    "pipeline_order": [
      "Extract",
      "Gate",
      "Think / Transform",
      "Compose",
      "Place and Record"
    ],
    "hard_rules": [
      "Do not extend the legacy tag-and-file pipeline as the authority.",
      "Do not write new feature code until ExtractionResult and DecisionNote schemas are locked.",
      "Do not let bash contain data logic.",
      "Do not let tags become the architecture.",
      "Do not treat file extension as truth.",
      "Do not treat empty extraction, corrupt files, OCR-needed files, unsupported files, and scrap as the same thing.",
      "Do not use LLM self-confidence as the gate.",
      "Do not auto-delete uncertain files.",
      "Do not overwrite vault notes without a collision policy.",
      "Do not build OCR/video/media before proving Stage 3 produces useful notes."
    ],
    "preferred_rules": [
      "Use one config loader.",
      "Use one state manager.",
      "Use one canonical state schema.",
      "Use SHA-256 source hashes for idempotency.",
      "Use file locking and atomic writes for state.",
      "Preserve original files untouched.",
      "Write human-readable Markdown notes.",
      "Use machine-readable sidecar metadata only as support, not as the main output.",
      "Send uncertain files to review.",
      "Record major design decisions as ADRs."
    ]
  },

  "recommended_file_structure": {
    "knowledge-pipeline": {
      "config": [
        "paths.conf",
        "note_quality.md",
        "scrap_heuristics.json",
        "categories.json",
        "business_areas.json",
